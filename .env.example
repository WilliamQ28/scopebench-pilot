# The Anthropic API key used by the default model.
ANTHROPIC_API_KEY=sk-ant-...

# Keys for the other sandbox-supported providers — only needed when running an
# openai:/google:/openrouter: model (`scopebench --list-models` shows the slugs
# and which keys are configured).
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...

# Optional: override the model with any PydanticAI model string, e.g.
#   openai:gpt-5.2, google:gemini-2.5-pro, anthropic:claude-sonnet-4-5
# HARNESS_MODEL=anthropic:claude-sonnet-4-5

# Where `scopebench` finds the ScopeBench task dirs (no built-in
# default; alternatively pass --tasks-dir on each run).
# SCOPEBENCH_TASKS_DIR=/absolute/path/to/scopebench-tasks
